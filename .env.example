# Database (local: docker compose up -d)
DATABASE_URL=postgres://amjad:amjad@localhost:5432/amjadscorner

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth (optional locally; providers are enabled only when both values are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional locally; without a key, emails are logged to the console)
RESEND_API_KEY=
EMAIL_FROM=
